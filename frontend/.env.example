# Base URL of the API. /api keeps the browser on a single origin: nginx
# proxies it to the backend in prod, Vite does it in dev (see below).
VITE_API_URL=/api
# Dev only: where Vite forwards /api.
VITE_API_PROXY_TARGET=http://localhost:3001
# Cloudflare Turnstile public site key (empty: no captcha in dev).
VITE_TURNSTILE_SITE_KEY=
