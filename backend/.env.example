PORT=3001
# Local development only: true skips every check below so the API starts
# with throwaway values. Never set it in production.
DEV=false
# Public origin of the site (CORS, cookies). An https:// value turns on
# Secure cookies and makes TURNSTILE_SECRET_KEY mandatory.
PUBLIC_URL=http://localhost:5174
# Serves the OpenAPI docs on /api/docs when true.
SWAGGER=false

# The backend refuses to start while a secret below is missing, too short
# or a well-known default (changeme, minioadmin, root…).
# Generate each one with: openssl rand -hex 32
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=urls
DB_PASSWORD=
DB_DATABASE=urls

# At least 32 characters each, and different from one another.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Key of the HMAC-SHA-256 applied to visitor IPs before they are stored in
# the click statistics: the clear IP is never stored nor logged. At least
# 32 characters. Changing it makes new hashes unrelated to the old ones
# (unique visitors are then counted again).
IP_HASH_SECRET=

# The single admin account, created on first start when the database has
# no account yet. Never modified afterwards: change the password from the
# dashboard. 12+ characters with an uppercase letter, a lowercase letter,
# a digit and a symbol.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# S3 storage (RustFS). S3_ENDPOINT is how the backend reaches it (Docker
# service name in prod). S3_PUBLIC_ENDPOINT is the public host used only
# to sign the presigned URLs given to browsers (https://cdn.addrien.fr in
# prod): the signature covers the host, so an internal one is rejected.
# The access key must be a dedicated user limited to S3_BUCKET.
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=https://cdn.example.org
S3_REGION=us-east-1
S3_ACCESS_KEY=urls
S3_SECRET_KEY=
S3_BUCKET=urls

# Cloudflare Turnstile secret, required when PUBLIC_URL is https://.
TURNSTILE_SECRET_KEY=

# Client IP used for rate limits, Turnstile and the audit log. Behind the
# Cloudflare Tunnel set CLIENT_IP_HEADER=cf-connecting-ip: Cloudflare
# overwrites it, a forged X-Forwarded-For is then ignored. Without it, the
# IP comes from X-Forwarded-For, trusting TRUST_PROXY_HOPS proxies.
# CLIENT_IP_HEADER=cf-connecting-ip
# TRUST_PROXY_HOPS=1
