# Root .env, read by docker compose only. The backend reads backend/.env.
# Generate every secret with: openssl rand -hex 32

# --- docker-compose.yml (full stack) ---
MYSQL_ROOT_PASSWORD=
# Must match DB_USERNAME / DB_PASSWORD / DB_DATABASE of backend/.env.
DB_USERNAME=urls
DB_PASSWORD=
DB_DATABASE=urls
# RustFS admin account (only used by storage-init, never by the app).
RUSTFS_ADMIN_ACCESS_KEY=
RUSTFS_ADMIN_SECRET_KEY=
# App S3 user created by storage-init: must match backend/.env.
S3_BUCKET=urls
S3_ACCESS_KEY=urls
S3_SECRET_KEY=
S3_QUOTA=75G
# Origin allowed by the bucket CORS (browser uploads).
PUBLIC_URL=https://url.addrien.fr
# Host address and ports of mariadb (3307) and rustfs (9010).
BACKING_BIND_ADDRESS=127.0.0.1
# MYSQL_HOST_PORT=3307
# RUSTFS_HOST_PORT=9010

# --- both compose files ---
# Host address and port of the frontend, served by the Cloudflare Tunnel.
BIND_ADDRESS=127.0.0.1
# FRONTEND_HOST_PORT=8081
BACKEND_MEM_LIMIT=512m
# Cloudflare Turnstile public site key, baked into the frontend build.
VITE_TURNSTILE_SITE_KEY=

# --- docker-compose.external.yml (prod) ---
# Existing internal networks where the backend reaches the database and
# the storage. URLS_TAG (image tag, latest by default) is set by deploys.
DATABASE_NETWORK=db-urls
STORAGE_NETWORK=s3-urls
